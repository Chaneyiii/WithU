{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/reply-block",
  "title": "Withu intelligent UI reply block",
  "type": "object",
  "required": ["schema_version", "block_id", "conversation_id", "turn_id", "source", "status_version", "visibility", "kind", "action_ref", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "block_id": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "turn_id": { "type": "string", "minLength": 1 },
    "source": { "enum": ["withu", "local_adapter", "user"] },
    "status_version": { "type": "integer", "minimum": 1 },
    "visibility": { "enum": ["conversation", "turn", "private_preview"] },
    "kind": { "enum": ["text", "summary", "list", "selection", "approval", "error", "unavailable"] },
    "action_ref": {
      "type": ["object", "null"],
      "required": ["action_id", "expected_revision", "approval_ref", "idempotency_key", "cancel_token", "expires_at"],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "expected_revision": { "type": "integer", "minimum": 1 },
        "approval_ref": { "type": ["string", "null"] },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "cancel_token": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "description", "version"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "description", "version"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "description": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "decision": { "enum": ["pending", "allow", "deny", "expired"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
