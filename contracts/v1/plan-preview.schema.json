{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/plan-preview",
  "title": "transaction plan preview",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "actions",
    "policy_version",
    "authorization_version",
    "cancel_token",
    "external_effects",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "goal": {
      "type": "object",
      "required": ["description", "user_evidence_ref"],
      "properties": {
        "description": { "type": "string", "minLength": 1 },
        "user_evidence_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./action-execution.schema.json" }
    },
    "policy_version": { "type": "integer", "minimum": 1 },
    "authorization_version": { "type": "integer", "minimum": 1 },
    "cancel_token": { "type": "string", "minLength": 1 },
    "external_effects": { "const": false },
    "created_at": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
