{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/config-test",
  "title": "ConfigTest",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "model_ref",
    "kind",
    "config_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "type": "string"
    },
    "model_ref": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "llm",
        "realtime"
      ]
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "voice_id": {
      "type": "string",
      "maxLength": 128
    }
  },
  "additionalProperties": false
}
