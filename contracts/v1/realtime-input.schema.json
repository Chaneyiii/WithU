{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "realtime-input",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "sequence",
    "audio_base64"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "$ref": "./realtime-scope.schema.json"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "audio_base64": {
      "type": "string",
      "maxLength": 6400
    }
  },
  "additionalProperties": false,
  "$id": "withu://contracts/v1/realtime-input"
}
