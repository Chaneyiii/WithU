{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/model-list",
  "title": "ModelList",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "kind",
    "config_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "provider_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "llm",
        "realtime"
      ]
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
