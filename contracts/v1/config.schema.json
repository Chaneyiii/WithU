{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/config",
  "title": "config",
  "type": "object",
  "required": [
    "schema_version",
    "config_version",
    "providers",
    "credential_refs",
    "defaults",
    "model_overrides",
    "speech_preferences"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "./provider.schema.json"
      }
    },
    "credential_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "defaults": {
      "type": "object",
      "required": [
        "llm",
        "realtime"
      ],
      "properties": {
        "llm": {
          "type": [
            "string",
            "null"
          ]
        },
        "realtime": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "model_overrides": {
      "type": "object",
      "properties": {
        "llm": {
          "type": "object",
          "properties": {
            "provider_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "reasoning_effort": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 24
            }
          },
          "required": [
            "provider_ref",
            "model_ref"
          ],
          "additionalProperties": false
        },
        "realtime": {
          "type": "object",
          "properties": {
            "provider_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "model_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "provider_ref",
            "model_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "speech_preferences": {
      "type": "object",
      "properties": {
        "realtime": {
          "type": "object",
          "properties": {
            "voice_id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 128
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
