{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/speech-session",
  "title": "speech-session",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "conversation_id",
    "renderer_id",
    "turn_id",
    "config_version",
    "generation",
    "version",
    "state",
    "backend_id",
    "muted",
    "attached",
    "synthetic",
    "transcript_revision",
    "pending_work",
    "discarded_stale",
    "cleanup_complete"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "renderer_id": {
      "type": "string"
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "idle",
        "listening",
        "thinking",
        "speaking",
        "interrupted",
        "reconnecting",
        "degraded",
        "ended"
      ]
    },
    "backend_id": {
      "enum": [
        "fake-a",
        "fake-b"
      ]
    },
    "muted": {
      "type": "boolean"
    },
    "attached": {
      "type": "boolean"
    },
    "synthetic": {
      "const": true
    },
    "transcript_revision": {
      "type": "integer",
      "minimum": 0
    },
    "pending_work": {
      "type": "integer",
      "minimum": 0
    },
    "discarded_stale": {
      "type": "integer",
      "minimum": 0
    },
    "cleanup_complete": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
