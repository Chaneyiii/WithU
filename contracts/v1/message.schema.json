{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/message",
  "title": "message",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "conversation_id",
    "role",
    "text",
    "file_refs",
    "submitted_at",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "role": {
      "const": "user"
    },
    "text": {
      "type": "string"
    },
    "file_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "submitted_at": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
