{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/affect-feedback",
  "title": "affect-feedback",
  "type": "object",
  "required": ["schema_version", "conversation_id", "turn_id", "action", "user_feedback", "next_turn_signal", "outcome", "user_correction"],
  "properties": {
    "schema_version": {"const": 1},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "turn_id": {"type": "string"},
    "action": {"enum": ["reflect_confirm", "listen", "accompany", "shared_quiet", "clarify", "distract", "advice", "transaction", "pause_interaction"]},
    "user_feedback": {"type": ["string", "null"]},
    "next_turn_signal": {"type": ["string", "null"]},
    "outcome": {"enum": ["improved", "unchanged", "misread", "unknown"]},
    "user_correction": {"type": ["object", "null"], "required": ["turn_id", "corrected_emotion", "corrected_need", "boundary", "recorded_at"], "properties": {"turn_id": {"type": "string"}, "corrected_emotion": {"type": ["string", "null"], "enum": ["sadness", "anxiety", "anger", "shame", "loneliness", "joy", "tired", "mixed", "unclear", null]}, "corrected_need": {"type": ["string", "null"], "enum": ["listening", "emotional_confirmation", "companionship", "shared_quiet", "distraction", "advice", "transaction_help", "pause_interaction", null]}, "boundary": {"type": ["string", "null"]}, "recorded_at": {"type": "string"}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
