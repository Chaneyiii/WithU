{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/local-annotation",
  "title": "Owner local annotation",
  "type": "object",
  "required": ["schema_version", "scope", "target_id", "version", "value", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "scope": { "const": "comfort:local" },
    "target_id": { "const": "demo-item" },
    "version": { "type": "integer", "minimum": 2 },
    "value": { "type": "string", "maxLength": 120 },
    "updated_at": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
