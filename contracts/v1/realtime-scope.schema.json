{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "realtime-scope",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "conversation_id",
    "renderer_id",
    "config_version",
    "generation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "session_id": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "renderer_id": {
      "type": "string"
    },
    "config_version": {
      "type": "integer",
      "minimum": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "$id": "withu://contracts/v1/realtime-scope"
}
