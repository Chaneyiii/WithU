{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/memory-persistence",
  "title": "memory-persistence-record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "scope",
    "object_version",
    "state_version",
    "kind",
    "source_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "object_version": { "type": "integer", "minimum": 1 },
    "state_version": { "type": "integer", "minimum": 1 },
    "kind": {
      "enum": ["stable_fact", "explicit_preference", "explicit_experience"]
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
