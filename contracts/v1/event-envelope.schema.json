{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "withu://contracts/v1/event-envelope",
  "title": "event-envelope",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "client_session_id",
    "record",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_session_id": {
      "type": "string"
    },
    "record": {
      "$ref": "./event.schema.json"
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
