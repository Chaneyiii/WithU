{
  "name": "withu-client",
  "version": "0.3.1-go.4",
  "private": true,
  "type": "module",
  "workspaces": [
    "client/*"
  ],
  "scripts": {
    "check": "node checks/contracts.mjs",
    "check:lifecycle": "node checks/lifecycle.mjs",
    "build": "cargo build --workspace && vite build --config client/withu-renderer/vite.config.mjs",
    "build:contracts": "node --check client/withu-window/index.mjs && node --check client/withu-preload/index.mjs && node --check client/withu-ipc/index.mjs",
    "start": "electron .",
    "check:gui": "electron . --withu-check",
    "preview:gui": "vite --config client/withu-renderer/vite.config.mjs",
    "check:server": "node checks/server.mjs",
    "package:windows": "node checks/package-windows.mjs",
    "check:desktop": "node checks/desktop-run.mjs",
    "check:packaged": "node checks/desktop-run.mjs --packaged",
    "check:product": "node checks/product-scan.mjs",
    "preview:p2": "node checks/presence-preview.mjs",
    "check:presence": "node checks/presence.mjs",
    "check:speech:server": "node checks/speech-server.mjs",
    "check:speech:desktop": "node checks/speech-desktop-run.mjs",
    "check:speech:packaged": "node checks/speech-desktop-run.mjs --packaged",
    "package:p2": "node checks/package-windows.mjs --p2",
    "check:speech:suite": "node checks/speech-suite.mjs",
    "check:speech:suite:packaged": "node checks/speech-suite.mjs --packaged",
    "check:p2:freeze": "node checks/p2-package-freeze.mjs",
    "preview:p3": "node checks/model-config-preview.mjs",
    "check:models:gui": "node checks/model-config-gui.mjs",
    "check:models:server": "node checks/model-config-server.mjs",
    "check:reply:wire": "node checks/reply-wire.mjs",
    "check:models:flight": "node checks/model-test-flight.mjs",
    "check:audio:transport": "node checks/audio-transport.mjs",
    "build:icon": "electron checks/build-icon.cjs",
    "package:p3": "node checks/package-windows.mjs --p3",
    "check:p3:packaged": "node checks/desktop-run.mjs --p3 --packaged",
    "check:providers": "node checks/provider-presets.mjs",
    "check:providers:wire": "node checks/provider-discovery.mjs",
    "check:chat:tools": "node checks/chat-tools-wire.mjs",
    "check:renderer": "node checks/renderer-mapping.mjs",
    "check:realtime:tools": "node checks/realtime-tools.mjs",
    "check:soul": "node checks/soul-inject-probe.mjs",
    "check:chat:gui": "node checks/chat-gui.mjs",
    "check:mcp-app": "npm test --workspace @withu/mcp-app-demo",
    "check:proactivity:notify": "node checks/proactivity-notification.mjs",
    "check:mcp:client": "node checks/mcp-client.mjs",
    "check:mcp:tools": "node checks/mcp-tools-wire.mjs"
  },
  "main": "client/withu-window/main.cjs",
  "dependencies": {
    "@paper-design/shaders-react": "^0.0.81",
    "ajv": "^8.17.1",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@44.7.0": true
  }
}
